{
  "_about": "The validations of a declared medallion flow (spec 3.8.1, 3.8.2), each naming the question it protects.",
  "rules": [
    {
      "id": "medallion-step-declares-its-kind",
      "kind": "policy",
      "severity": "blocking",
      "when": [
        {
          "node": "f",
          "type": "Flow",
          "where": {
            "flowKind": "medallion"
          }
        },
        {
          "edge": [
            "f",
            "hasStep",
            "s"
          ]
        },
        {
          "node": "s",
          "type": "DeterministicStep|OcrStep|ClaudeStep|HumanStep",
          "where": {
            "stepKind": {
              "exists": false
            }
          }
        }
      ],
      "then": {
        "flag": "a step of a medallion flow declares no step kind"
      },
      "why": "The kinds are the flow's vocabulary; a step without one cannot be checked against it (spec 3.8.1).",
      "validated_by": "",
      "answers": "MD1"
    },
    {
      "id": "medallion-step-kind-is-known",
      "kind": "policy",
      "severity": "blocking",
      "when": [
        {
          "node": "f",
          "type": "Flow",
          "where": {
            "flowKind": "medallion"
          }
        },
        {
          "edge": [
            "f",
            "hasStep",
            "s"
          ]
        },
        {
          "node": "s",
          "type": "Step",
          "where": {
            "stepKind": {
              "not_in": [
                "create_batch",
                "check_sources_ready",
                "copy_to_bronze",
                "run_gate",
                "build_reference",
                "build_entity",
                "build_output",
                "reconcile",
                "mark_validated"
              ]
            }
          }
        }
      ],
      "then": {
        "flag": "the step kind is not one of the medallion's: create_batch, check_sources_ready, copy_to_bronze, run_gate, build_reference, build_entity, build_output, reconcile, mark_validated"
      },
      "why": "A flow uses only the fixed kinds, so the implementation agent can emit every step from a template (spec 3.8.1, 3.8.2 Vocabulary).",
      "validated_by": "",
      "answers": "MD1"
    },
    {
      "id": "medallion-gate-has-a-number",
      "kind": "policy",
      "severity": "blocking",
      "when": [
        {
          "node": "f",
          "type": "Flow",
          "where": {
            "flowKind": "medallion"
          }
        },
        {
          "edge": [
            "f",
            "hasStep",
            "s"
          ]
        },
        {
          "node": "s",
          "type": "Step",
          "where": {
            "stepKind": "run_gate",
            "gate": {
              "exists": false
            }
          }
        }
      ],
      "then": {
        "flag": "a run_gate step does not say which gate it runs (1, 2 or 3)"
      },
      "why": "Each gate runs at one boundary: 1 landing to bronze, 2 bronze to silver, 3 silver to gold (spec 3.7).",
      "validated_by": "",
      "answers": "MD2"
    },
    {
      "id": "medallion-flow-has-create-batch",
