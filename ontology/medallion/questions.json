                "node": "p",
                "type": "CopyPolicy"
              }
            ]
          },
          {
            "optional": [
              {
                "edge": [
                  "p",
                  "watermark",
                  "w"
                ]
              }
            ]
          },
          {
            "optional": [
              {
                "edge": [
                  "t",
                  "date_column",
                  "dc"
                ]
              }
            ]
          },
          {
            "optional": [
              {
                "edge": [
                  "t",
                  "has_key",
                  "k"
                ]
              }
            ]
          },
          {
            "optional": [
              {
                "edge": [
                  "t",
                  "stewarded_by",
                  "who"
                ]
              }
            ]
          },
          {
            "optional": [
              {
                "edge": [
                  "t",
                  "has_column",
                  "c"
                ]
              },
              {
                "node": "c",
                "type": "SourceColumn"
              }
            ]
          }
        ],
        "select": [
          "s.label",
          "s.source_kind",
          "s.access_method",
          "s.source_side_logic_allowed",
          "t.schema",
          "t.table_name",
          "t.change_behaviour",
          "t.change_behaviour_evidence",
          "t.expected_at_period_end",
          "t.delivery_lag",
          "dc.label",
          "k.label",
          "who.label",
          "p.method",
          "p.lookback",
          "p.source_side_filter",
          "p.retention_hot",
          "p.retention_cold",
          "w.label",
