          },
          {
            "node": "f",
            "type": "DatasetField"
          },
          {
            "optional": [
              {
                "edge": [
                  "c",
                  "inTable",
                  "t"
                ]
              },
              {
                "edge": [
                  "t",
                  "is_dataset",
                  "d"
                ]
              }
            ]
          },
          {
            "optional": [
              {
                "edge": [
                  "f",
